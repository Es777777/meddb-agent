{
  "database": {
    "host": "127.0.0.1",
    "port": 5432,
    "dbname": "mimic_official_compare",
    "user": "meddb_mimic_reader",
    "connect_timeout_seconds": 5,
    "statement_timeout_ms": 30000,
    "lock_timeout_ms": 5000,
    "application_name": "meddb-mimic-official"
  },
  "security": {
    "allowed_schemas": [
      "mimiciii",
      "mimiciv_hosp",
      "mimiciv_icu"
    ],
    "metadata_only_schemas": [],
    "blocked_table_patterns": [
      "^raw($|_)",
      "(^|_)raw($|_)",
      "^import_manifest$",
      "^data_quality_issues$",
      "_pre_precision_fix$"
    ],
    "codex_safe_database_users": [
      "meddb_mimic_reader"
    ],
    "catalog_excluded_table_patterns": [
      "^import_manifest$",
      "^data_quality_issues$",
      "_pre_precision_fix$"
    ],
    "aggregate_max_rows": 1000,
    "detail_max_rows": 100,
    "codex_aggregate_max_rows": 200,
    "codex_max_output_bytes": 1048576,
    "catalog_max_rows": 200,
    "max_plan_total_cost": 5000000,
    "require_qualified_tables": true,
    "require_aggregate_by_default": true,
    "block_select_star": true,
    "blocked_functions": [
      "dblink",
      "dblink_exec",
      "lo_export",
      "lo_import",
      "nextval",
      "pg_advisory_lock",
      "pg_advisory_lock_shared",
      "pg_cancel_backend",
      "pg_ls_dir",
      "pg_read_binary_file",
      "pg_read_file",
      "pg_reload_conf",
      "pg_rotate_logfile",
      "pg_stat_file",
      "pg_terminate_backend",
      "set_config",
      "setval"
    ]
  },
  "paths": {
    "catalog": "catalog/meddb-mimic-official.sqlite",
    "templates": "templates",
    "exports": "exports",
    "audit": "audit/audit.jsonl"
  },
  "codex": {
    "config": "~/.codex/config.toml",
    "no_mcp_profile": "~/.codex/no-mcp.config.toml",
    "plugin_cache": "~/.codex/cache"
  }
}