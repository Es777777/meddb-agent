      "description_cn": "按主题域汇总组件家族和原始文件数量。",
      "datasets": ["nhanes"],
      "sql_file": "nhanes-component-inventory.sql",
      "detail": false,
      "notes": ["该模板只读取元数据，不读取参与者记录。"],
      "parameters": [
        {"name": "dataset", "type": "str", "required": true}
      ],
      "dataset_identifiers": {"nhanes": {}}
    },
    {
      "id": "nhanes-variable-search",
      "title_cn": "NHANES变量字典搜索",
      "description_cn": "按字段名、中英文标签搜索变量字典。",
      "datasets": ["nhanes"],
      "sql_file": "nhanes-variable-search.sql",
