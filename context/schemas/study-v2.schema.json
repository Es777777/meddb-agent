{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 2
    },
    "study_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "enum": [
            "mimiciv",
            "seer8",
            "seer12",
            "seer17",
            "nhanes",
            "brfss"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "version"
      ]
    },
    "analysis_unit": {
      "type": "string",
      "minLength": 1
    },
    "population": {
      "enum": [
        "sample",
        "population"
      ]
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "index_event": {
          "type": "string",
          "minLength": 1
        },
        "time_window": {
          "type": "string",
          "minLength": 1
        },
        "denominator": {
          "type": "string",
          "minLength": 1
        },
        "exposure_window": {
          "type": "string",
          "minLength": 1
        },
        "followup": {
          "type": "string",
          "minLength": 1
        },
        "censoring": {
          "type": "string",
          "minLength": 1
        },
        "estimand": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "index_event",
        "time_window",
        "denominator",
        "exposure_window",
        "followup",
        "censoring",
        "estimand"
      ]
    },
    "data": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "file"
              ]
            },
            "path": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "path"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "postgres"
            },
            "config": {
              "type": "string",
              "minLength": 1
            },
            "sql": {
              "type": "string",
              "minLength": 1
            },
            "params": {
              "type": "object"
            },
            "output_columns": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          },
          "required": [
            "kind",
            "config",
            "sql",
            "params",
            "output_columns"
          ]
        }
      ]
    },
    "cohort": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "column": {
            "type": "string",
            "minLength": 1
          },
          "op": {
            "enum": [
              "eq",
              "ne",
              "gt",
              "ge",
              "lt",
              "le",
              "in"
            ]
          },
          "value": {
            "type": [
              "string",
              "number",
              "boolean",
              "array"
            ]
          }
        },
        "required": [
          "column",
          "op",
          "value"
        ]
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "outcome": {
          "type": "string",
          "minLength": 1
        },
        "exposure": {
          "type": "string",
          "minLength": 1
        },
        "duration": {
          "type": "string",
          "minLength": 1
        },
        "event": {
          "type": "string",
          "minLength": 1
        },
        "group": {
          "type": "string",
          "minLength": 1
        },
        "weight": {
          "type": "string",
          "minLength": 1
        },
        "strata": {
          "type": "string",
          "minLength": 1
        },
        "psu": {
          "type": "string",
          "minLength": 1
        },
        "split_column": {
          "type": "string",
          "minLength": 1
        },
        "cluster_key": {
          "type": "string",
          "minLength": 1
        },
        "estimand": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "enum": [
            "describe",
            "linear",
            "logistic",
            "kaplan_meier",
            "cox",
            "competing_risk",
            "survey_mean",
            "survey_linear",
            "survey_logistic",
            "predict",
            "aipw"
          ]
        },
        "covariates": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "categorical": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "missing": {
          "enum": [
            "complete_case",
            "median"
          ]
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "test_fraction": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 0.5
        },
        "split": {
          "enum": [
            "group",
            "temporal"
          ]
        },
        "causal_assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "propensity_clip": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 0.2
        },
        "folds": {
          "type": "integer",
          "minimum": 2,
          "maximum": 10
        },
        "outcome_type": {
          "enum": [
            "binary",
            "continuous"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0.8,
          "maximum": 0.99
        }
      },
      "required": [
        "method"
      ]
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "keys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "min_rows": {
          "type": "integer",
          "minimum": 5
        },
        "max_missing": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ranges": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "allowed_values": {
          "type": "object",
          "additionalProperties": {
            "type": "array"
          }
        }
      },
      "required": [
        "keys",
        "min_rows",
        "max_missing"
      ]
    },
    "definitions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "column": {
            "type": "string",
            "minLength": 1
          },
          "concept": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "operational_definition": {
            "type": "string",
            "minLength": 1
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "reviewed": {
            "type": "boolean"
          },
          "availability": {
            "enum": [
              "baseline",
              "post_index",
              "unknown"
            ]
          }
        },
        "required": [
          "column",
          "concept",
          "unit",
          "operational_definition",
          "source_id",
          "reviewed",
          "availability"
        ]
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "pmid": {
            "type": "string",
            "minLength": 1
          },
          "year": {
            "type": "integer"
          },
          "verification": {
            "enum": [
              "curated",
              "pubmed",
              "unverified"
            ]
          }
        },
        "required": [
          "id",
          "title",
          "url",
          "verification"
        ]
      }
    },
    "sensitivity": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+$"
          },
          "analysis_overrides": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "covariates": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "missing": {
                "enum": [
                  "complete_case",
                  "median"
                ]
              },
              "propensity_clip": {
                "type": "number",
                "exclusiveMinimum": 0,
                "exclusiveMaximum": 0.2
              }
            },
            "required": []
          },
          "cohort": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "column": {
                  "type": "string",
                  "minLength": 1
                },
                "op": {
                  "enum": [
                    "eq",
                    "ne",
                    "gt",
                    "ge",
                    "lt",
                    "le",
                    "in"
                  ]
                },
                "value": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "array"
                  ]
                }
              },
              "required": [
                "column",
                "op",
                "value"
              ]
            }
          }
        },
        "required": [
          "name",
          "analysis_overrides",
          "cohort"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "study_id",
    "question",
    "dataset",
    "analysis_unit",
    "population",
    "design",
    "data",
    "cohort",
    "analysis",
    "quality",
    "definitions",
    "evidence",
    "sensitivity"
  ]
}
